# Set the base image - 1.98.2 
FROM n8nio/n8n:1.78.0

# Argumentos de build
ARG WEBHOOK_URL
ARG N8N_HOST
ARG GENERIC_TIMEZONE
ARG N8N_LOG_LEVEL
ARG N8N_COMMUNITY_PACKAGES_ALLOW_TOOL_USAGE

# Variaveis de ambiente
ENV WEBHOOK_URL=$WEBHOOK_URL \
    N8N_HOST=$N8N_HOST \
    GENERIC_TIMEZONE=$GENERIC_TIMEZONE \
    N8N_LOG_LEVEL=$N8N_LOG_LEVEL \
    N8N_COMMUNITY_PACKAGES_ALLOW_TOOL_USAGE=$N8N_COMMUNITY_PACKAGES_ALLOW_TOOL_USAGE

# Default port
EXPOSE 5678
